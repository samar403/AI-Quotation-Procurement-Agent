# Claude powers requirement extraction (text, PDFs, emails, and photos/screenshots of orders).
# Without a key, Taana falls back to its built-in rule-based textile parser (text sources only).
ANTHROPIC_API_KEY=

# Optional overrides
TAANA_MODEL=claude-opus-5-5
TAANA_EFFORT=medium
# Where the JSON datastore lives (defaults to ./.data)
TAANA_DATA_DIR=
